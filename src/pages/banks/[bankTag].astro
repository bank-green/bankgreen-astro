---
import { BankScorePage } from '@components/pages'
import BaseLayout from '@layouts/BaseLayout.astro'
import { getDefaultFields } from '@lib/banks'
import { getByUIDSafe, prismicClient } from '@lib/prismic'
import { fetchBrandByTag } from '@lib/queries/brands'

// Full SSR - all bank routes handled dynamically
// This ensures every bank works, not just those known at build time

interface BankData {
  name: string
  tag: string
  website?: string | null
  commentary?: {
    rating?: string | null
    ratingInherited?: boolean | null
    inheritBrandRating?: {
      tag: string
      name: string
    } | null
    lastReviewed?: string | null
    headline?: string | null
    description1?: string | null
    description2?: string | null
    description3?: string | null
    ourTake?: string | null
    fossilFreeAlliance?: boolean | null
    showOnSustainableBanksPage?: boolean
    institutionType?: Array<{ name: string }> | null
  } | null
  countries?: Array<{ code: string }> | null
}

const { bankTag } = Astro.params

// Fetch bank data from GraphQL
const bank = await fetchBrandByTag(bankTag as string)

// Redirect to 404 if bank not found
if (!bank) {
  return Astro.redirect('/404')
}

const bankName = bank.name
const title = `${bankName}'s Climate Score`

// If this bank inherits its rating from a parent brand, fetch the parent's rating
let effectiveRating = bank.commentary?.rating || 'unknown'

if (bank.commentary?.ratingInherited && bank.commentary?.inheritBrandRating?.tag) {
  const parentBrand = await fetchBrandByTag(bank.commentary.inheritBrandRating.tag)
  if (parentBrand?.commentary?.rating) {
    effectiveRating = parentBrand.commentary.rating
  }
}

// Handle credit union logic
const getRating = (rating: string, bank: BankData): string => {
  const institutionTypes = bank.commentary?.institutionType || []
  const isCreditUnion = institutionTypes.some((type) => type.name === 'Credit Union')
  const isRatingUnknown = rating === 'unknown'

  // Credit unions with unknown rating default to 'good'
  if (isCreditUnion && isRatingUnknown) {
    return 'good'
  }

  return rating
}

const rating = getRating(effectiveRating, bank)

// Derive a single institution type string (Credit Union takes priority if present)
const institutionTypeNames = bank.commentary?.institutionType?.map((t) => t.name) || []
const isCreditUnion = institutionTypeNames.includes('Credit Union')
const institutionType = isCreditUnion ? 'Credit Union' : institutionTypeNames[0] || 'Bank'

const ratingImageUrl = `https://bank.green/anim/gauge/${rating}.gif`
const ratingVideoUrl = `https://bank.green/anim/gauge/${rating}.mp4`
const bankDescription = 'Find and compare the service offerings of ethical and sustainable banks.'

// Check if manual description fields are empty
const hasNoManualDescriptions =
  !bank.commentary?.description1 &&
  !bank.commentary?.description2 &&
  !bank.commentary?.description3 &&
  !bank.commentary?.ourTake

// Credit unions with no manual descriptions and rating unknown/good use the "unknown" default text
const effectiveDefaultRating =
  isCreditUnion && hasNoManualDescriptions && (rating === 'unknown' || rating === 'good')
    ? 'unknown'
    : rating

// Fetch Prismic defaults based on effective rating
const prismicDefaults = await getDefaultFields(prismicClient, effectiveDefaultRating, bankName, institutionType)

// Fetch Prismic page for SliceZone
const queryKey =
  effectiveDefaultRating === 'unknown'
    ? `unknownbank-${institutionType.toLowerCase().replace(/\s/g, '')}`
    : `${effectiveDefaultRating}bank`
const prismicPage = await getByUIDSafe('bankpage', queryKey)
const prismicNotListed = await getByUIDSafe('textonlypages', 'notlisted')
---

<BaseLayout title={title} description={bankDescription} ogImage={ratingImageUrl} ogImageWidth="680" ogImageHeight="689">
  <Fragment slot="head">
    <meta property="og:video" content={ratingVideoUrl} />
    <meta property="og:video:url" content={ratingVideoUrl} />
    <meta property="og:video:secure_url" content={ratingVideoUrl} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content="680" />
    <meta property="og:video:height" content="689" />
    <meta name="twitter:player" content={ratingVideoUrl} />
    <meta name="twitter:player:width" content="680" />
    <meta name="twitter:player:height" content="689" />
  </Fragment>
  <BankScorePage bank={bank} rating={rating} prismicDefaults={prismicDefaults} prismicPage={prismicPage} prismicNotListed={prismicNotListed} client:load />
</BaseLayout>
