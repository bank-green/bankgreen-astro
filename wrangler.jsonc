{
  "main": "dist/_worker.js/index.js",
  "name": "bankgreen-astro",
  "compatibility_date": "2025-12-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },

  // Contact page enquiries email the team inbox. See src/lib/notify.ts
  "send_email": [{ "name": "EMAIL", "destination_address": "hello@bank.green", "remote": true }],

  "observability": {
    "enabled": true
  },

  // Custom domain — matches the route configured in the Cloudflare dashboard
  "routes": [{ "pattern": "bank.green", "custom_domain": true }]
}
