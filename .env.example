PUBLIC_GRAPHQL_ENDPOINT=https://data.bank.green/graphql

# Cloudflare Turnstile — local testing
# Official dummy sitekeys (https://developers.cloudflare.com/turnstile/troubleshooting/testing/):
#   1x00000000000000000000AA  always passes (visible)
#   2x00000000000000000000AB  always blocks (visible)
#   3x00000000000000000000FF  forces an interactive challenge

PUBLIC_CLOUDFLARE_CAPTCHA_SITEKEY=1x00000000000000000000AA
PUBLIC_CAPTCHA_TEST_MODE=false
CAPTCHA_TEST_MODE=false

# Pin the location /api/geolocation reports, instead of detecting it.
# Two-letter codes. Equivalent to /api/geolocation?country=US&state=CA
# DEV_LOCATION_COUNTRY=US
# DEV_LOCATION_STATE=CA
